# CompanySysAPI production environment — copy to CompanySysAPI/.env on the server
# and fill in. Never commit the real file.

PORT=3001

# --- Database ---
# Postgres on the same box: DB_HOST=localhost
# RDS: DB_HOST=<your-instance>.xxxx.ap-southeast-1.rds.amazonaws.com
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ios_db
DB_USER=companysys
DB_PASSWORD=CHANGE_ME

# --- Auth ---
# Keep the SAME value as the old server, or every user is logged out.
# Generate a new one only on a fresh install: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# --- Behind nginx ---
# Number of proxy hops. Off by default, because trusting X-Forwarded-For with
# no proxy in front lets any client forge its own IP and bypass rate limiting.
# On the server there IS one proxy, and without this req.protocol reads "http",
# so uploaded-file links come back as http:// on an https page and break.
TRUST_PROXY=1

# --- Browser access ---
# The app and API share one origin (nginx proxies /api), so CORS is not
# involved in normal use. Kept set so a request that does arrive cross-origin
# is refused rather than allowed by an empty allowlist.
CORS_ORIGINS=https://task.ips.com.my

# --- WhatsApp safety switch ---
# MUST NOT be set here. It exists so a developer's laptop cannot post to the
# real team group; on the server it would silently mute every ticket
# announcement and nothing would look broken.
# WHATSAPP_DRY_RUN=1

# XTECH credentials and the IRIS signing secret are NOT here — they live in the
# app_settings table and are edited in the app under Settings.
