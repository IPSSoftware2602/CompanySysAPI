# Dependencies — installed on the server with `npm ci`, never committed
node_modules/

# Secrets — never commit these
.env
.env.*
!.env.example

# OS noise
.DS_Store
**/.DS_Store

# Logs
*.log
server.log

# Uploads (runtime user content)
uploads/*
!uploads/.gitkeep

# Database dumps and data exports — a full dump carries every user's password
# hash and the XTECH token out of app_settings. Never in git.
data/backups/
data/*backup*.json
*.dump
*.sql
!schema.sql
