# Copy to .env and fill in real values. Never commit .env.

# Auth — REQUIRED. The app refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Database
DB_USER=
DB_HOST=localhost
DB_NAME=ios_db
DB_PASSWORD=
DB_PORT=5432

# Server
PORT=3001

# --- Reverse proxy -----------------------------------------------------------
# REQUIRED IN PRODUCTION. Rate limiting buckets by client IP; behind nginx /
# cPanel / Cloudflare every request arrives from the proxy, so without this the
# whole team shares one bucket and a single attacker locks everyone out.
# Set to the number of proxy hops (usually 1). Leave EMPTY for local dev —
# trusting X-Forwarded-For with no proxy in front lets any client forge its IP
# and bypass the limit entirely.
TRUST_PROXY=

# --- CORS --------------------------------------------------------------------
# Extra allowed browser origins, comma-separated. https://task.ips.com.my and
# the local Vite ports are always allowed; only set this if the app is ever
# served from somewhere else.
CORS_ORIGINS=

# --- SLA alerts --------------------------------------------------------------
# Where jobs/slaBreachCheck.js posts breach warnings. Unset means the job logs
# what it would have sent and nobody is notified.
# Runs from cron:  */10 * * * * cd /path/to/backend && node jobs/slaBreachCheck.js
SLA_ALERT_WEBHOOK=
