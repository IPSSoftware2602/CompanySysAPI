# Copy to .env and fill in real values. Never commit .env.

# Auth — REQUIRED. The app refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Database
DB_USER=
DB_HOST=localhost
DB_NAME=ios_db
DB_PASSWORD=
DB_PORT=5432

# Server
PORT=3001
